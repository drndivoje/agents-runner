# Scaffold: copy agents/example/ to agents/<your-repo>/ and fill in.
# Config shared by every agent in this folder. Every variable here is exported to the hooks
# (pre.sh, check.sh, post.sh), so you can add your own. An agent.env can override any of it.

# Where pre.sh gets the code from (used only by pre.sh, not by the runner).
REPO_URL=https://github.com/you/myrepo.git

# Base image with your project's toolchain; bin/agent builds the agent image on top of it.
# Unset = JDK 25 (eclipse-temurin). Examples:
#   IMAGE=node:22-bookworm
#   IMAGE=python:3.13-bookworm
