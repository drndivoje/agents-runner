# Config for one agent. The folder name (my-agent) is the agent's name: the runner calls
#   claude --agent my-agent
# so the target repo needs .claude/agents/my-agent.md (start from examples/claude-agents/my-agent.md).
# Rename the folder and that file together, or set CLAUDE_AGENT=<name> here.

# Security boundary, enforced by the runner whatever the agent definition asks for.
# Read-only agent:      "Read,Grep,Glob"
# Agent that edits:     "Read,Edit,Write,Grep,Glob"
# Agent that runs tests: add the exact command, e.g. "Read,Edit,Write,Grep,Glob,Bash(npm test:*)"
ALLOWED_TOOLS="Read,Grep,Glob"

MAX_TURNS=30          # stop after this many model turns
TIMEOUT_MINUTES=30    # hard limit for the claude step
MODEL=sonnet          # optional; unset = the model in the agent definition

# Your own settings for the hooks (every variable here is exported to them), for example:
# TEST_COMMAND="npm test"                 # used by check.sh
# CACHE_DIRS="/home/agent/.npm"           # dependency caches kept between runs
