# Copy to secrets/.env, fill in, then: chmod 600 secrets/.env
# Never set ANTHROPIC_API_KEY — auth uses the Claude Pro subscription token.

# From `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Fine-grained PAT, repo drndivoje/whereisivan only: Contents read, Issues read/write
GH_TOKEN_ISSUE_FINDER=

# Fine-grained PAT, repo drndivoje/whereisivan only: Contents read/write, Pull requests read/write, Issues read
GH_TOKEN_ISSUE_FIXER=
